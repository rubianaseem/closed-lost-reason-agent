# Optional. Without it the agent uses its built-in rules and templates.
ANTHROPIC_API_KEY=
# Optional: override the model (see https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Days with no activity before close that count as "went dark"
WENT_DARK_DAYS=30
# Competitor names to look for in rep notes, comma-separated
KNOWN_COMPETITORS=Gong,Clari,Outreach,Salesloft,Apollo,People.ai,BoostUp
